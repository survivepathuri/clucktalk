          "tool": "get_health_check",
          "args": {
            "check_id": "$check_id"
          },
          "poll_until": {
            "field": "status",
            "op": "ne",
            "value": "analyzing"
          },
          "checks": [
            {
              "field": "urgency",
              "op": "eq",
              "value": "urgent"

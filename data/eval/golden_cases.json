{
  "note": "Minimal golden suite v0 (2026-09-29), mock mode, no AWS. Extended to the full 45-case suite on the 11 Oct task (WEEK2_PLAN). Independent-mode plan_sale cases only: contract-mode is a stateful multi-call flow (switch mode, save terms), covered by tests/contract/test_sale_tools.py instead of this single-call runner. Multi-step cases (2026-09-29, health triage): `steps` run in order on one session; `save` keeps a result field for later steps (`$name`); `poll_until` repeats a read-only step until the agent's slow path finishes; `model_fixture` runs the case against a server whose model is a test fixture (tests/fakes.py), to prove the safety floor and fail-loud paths.",
  "cases": [
    {
      "id": "farm-status-invocation-example",
      "description": "Doc PRD invocation example: shed two's mortality/feed alert.",
      "tool": "get_farm_status",
      "args": {
        "house": "shed two"
      },
      "checks": [
        {
          "field": "level",
          "op": "eq",
          "value": "alert"
        },
        {
          "field": "text_en",
          "op": "contains",
          "value": "26 birds died today"
        }
      ]
    },
    {
      "id": "feed-plan-reorder",
      "description": "Shed two's low feed stock triggers a reorder suggestion.",
      "tool": "plan_feed",
      "args": {
        "house": "shed two"
      },
      "checks": [
        {
          "field": "plans.0.reorder_needed",
          "op": "eq",
          "value": true
        },
        {
          "field": "plans.0.stock_kg",
          "op": "eq",
          "value": 900
        }
      ]
    },
    {
      "id": "sale-rising-mortality-sell-now",
      "description": "House 3: 3 days of rising mortality -> plan_sale says sell today (docs/DESIGN.md §12.4).",
      "tool": "plan_sale",
      "args": {
        "house": "shed 3"
      },
      "checks": [
        {
          "field": "plans.0.mortality_rising",
          "op": "eq",
          "value": true
        },
        {
          "field": "plans.0.best_day_index",
          "op": "eq",
          "value": 0
        },
        {
          "field": "plans.0.break_even_day_index",
          "op": "eq",
          "value": 1
        },
        {
          "field": "text_en",
          "op": "contains",
          "value": "selling today is best"
        }
      ]
    },
    {
      "id": "sale-before-break-even",
      "description": "House 1 at a lower rate (₹80/kg): day 3 is still before the break-even day (8).",
      "tool": "plan_sale",
      "args": {
        "house": "house one",
        "live_price_per_kg": 80
      },
      "checks": [
        {
          "field": "plans.0.break_even_day_index",
          "op": "eq",
          "value": 8
        },
        {
          "field": "plans.0.days.3.marginal_profit_inr",
          "op": "gt",
          "value": 0
        }
      ]
    },
    {
      "id": "sale-at-break-even",
      "description": "House 1 at ₹80/kg: marginal profit is still positive the day before break-even, negative on it.",
      "tool": "plan_sale",
      "args": {
        "house": "house one",
        "live_price_per_kg": 80
      },
      "checks": [
        {
          "field": "plans.0.days.7.marginal_profit_inr",
          "op": "ge",
          "value": 0
        },
        {
          "field": "plans.0.days.8.marginal_profit_inr",
          "op": "lt",
          "value": 0
        }
      ]
    },
    {
      "id": "sale-after-break-even",
      "description": "House 1 at ₹80/kg: the last projected day is still past break-even and still losing value.",
      "tool": "plan_sale",
      "args": {
        "house": "house one",
        "live_price_per_kg": 80
      },
      "checks": [
        {
          "field": "plans.0.days.10.marginal_profit_inr",
          "op": "lt",
          "value": 0
        }
      ]
    },
    {
      "id": "help-lists-sale",
      "description": "get_help mentions selling, so a new farmer can discover the feature.",
      "tool": "get_help",
      "args": {},
      "checks": [
        {
          "field": "text_en",
          "op": "contains",
          "value": "sell"
        }
      ]
    },
    {
      "id": "record-book-log-report-read-back",
      "description": "log_daily_record propose-only (docs/DESIGN.md §5.1: read back before anything is saved; a two-call confirm flow isn't covered by this single-call runner, same as contract-mode plan_sale).",
      "tool": "log_daily_record",
      "args": {
        "house": "shed 1",
        "deaths": 5,
        "feed_bags": 3
      },
      "checks": [
        {
          "field": "status",
          "op": "eq",
          "value": "needs_confirmation"
        },
        {
          "field": "proposed.deaths",
          "op": "eq",
          "value": 5
        },
        {
          "field": "proposed.feed_bags",
          "op": "eq",
          "value": 3
        },
        {
          "field": "text_en",
          "op": "contains",
          "value": "5 died"
        },
        {
          "field": "text_en",
          "op": "contains",
          "value": "3 bags of feed"
        }
      ]
    },
    {
      "id": "record-book-no-dose-ever",
      "description": "A medicine/vaccine is read back by name only, never a dose (CLAUDE.md safety rule; Treatment has no dose field).",
      "tool": "log_daily_record",
      "args": {
        "house": "shed 1",
        "treatments": [
          {
            "kind": "vaccine",
            "name": "Newcastle"
          }
        ]
      },
      "checks": [
        {
          "field": "status",
          "op": "eq",
          "value": "needs_confirmation"
        },
        {
          "field": "proposed.treatments.0.name",
          "op": "eq",
          "value": "Newcastle"
        },
        {
          "field": "text_en",
          "op": "not_contains",
          "value": "dose"
        },
        {
          "field": "text_en",
          "op": "not_contains",
          "value": "ml"
        }
      ]
    },
    {
      "id": "record-book-nothing-logged-yet",
      "description": "A fresh demo farm: get_record_book shows every house still unlogged today.",
      "tool": "get_record_book",
      "args": {},
      "checks": [
        {
          "field": "houses_logged",
          "op": "eq",
          "value": 0
        },
        {
          "field": "houses_total",
          "op": "eq",
          "value": 3
        },
        {
          "field": "text_en",
          "op": "contains",
          "value": "No entry yet for House 1 today."
        }
      ]
    },
    {
      "id": "triage-respiratory-with-mortality-spike",
      "description": "House 2 (record-book spike of 26 deaths) + coughing: async check -> urgent, a breathing problem, vet today; no treatment advice.",
      "steps": [
        {
          "tool": "start_health_check",
          "args": {
            "house": "shed two",
            "signs": [
              "coughing",
              "sneezing"
            ]
          },
          "save": {
            "check_id": "check_id"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "analyzing"
            },
            {
              "field": "floor_urgency",
              "op": "eq",
              "value": "urgent"
            }
          ]
        },
        {
          "tool": "get_health_check",
          "args": {
            "check_id": "$check_id"
          },
          "poll_until": {
            "field": "status",
            "op": "ne",
            "value": "analyzing"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "ready"
            },
            {
              "field": "urgency",
              "op": "eq",
              "value": "urgent"
            },
            {
              "field": "consistent_with.0.category",
              "op": "eq",
              "value": "respiratory"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "26 birds died"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "not a diagnosis"
            },
            {
              "field": "text_en",
              "op": "not_contains",
              "value": " ml"
            },
            {
              "field": "text_en",
              "op": "not_contains",
              "value": "antibiotic"
            }
          ]
        }
      ]
    },
    {
      "id": "triage-heat-watch-calm-house",
      "description": "House 1 (no spike) + panting: watch, heat stress, shed temperature check.",
      "steps": [
        {
          "tool": "start_health_check",
          "args": {
            "house": "shed one",
            "signs": [
              "panting"
            ]
          },
          "save": {
            "check_id": "check_id"
          }

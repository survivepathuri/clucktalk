    {
      "id": "triage-unmapped-words-never-not-urgent",
      "model_fixture": "always_routine",
      "description": "Red-flag words with no sign mapped, in a shed with no death spike, against a model that says 'routine': still a vet today, never 'not urgent'.",
      "steps": [
        {
          "tool": "start_health_check",
          "args": {
            "house": "shed one",
            "signs": [],
            "symptoms": "heads swollen, combs blue, many birds died suddenly overnight"
          },
          "save": {
            "check_id": "check_id"
          }
        },
        {
          "tool": "get_health_check",
          "args": {
            "check_id": "$check_id"
          },
          "poll_until": {
            "field": "status",
            "op": "ne",
            "value": "analyzing"
          },
          "checks": [
            {
              "field": "urgency",
              "op": "eq",
              "value": "urgent"
            },
            {
              "field": "text_en",
              "op": "not_contains",
              "value": "doesn't look urgent"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "vet today"
            },
            {
              "field": "handoff_offered",
              "op": "eq",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "triage-model-failure-fails-loud",
      "model_fixture": "always_fails",
      "description": "Model outage: the check says it couldn't finish, invents nothing, and the floor's advice is still spoken.",
      "steps": [
        {
          "tool": "start_health_check",
          "args": {
            "house": "shed two",
            "signs": [
              "coughing"
            ]
          },
          "save": {
            "check_id": "check_id"
          }
        },
        {
          "tool": "get_health_check",
          "args": {
            "check_id": "$check_id"
          },
          "poll_until": {
            "field": "status",
            "op": "ne",
            "value": "analyzing"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "failed"
            },
            {
              "field": "consistent_with",
              "op": "eq",
              "value": []
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "couldn't finish"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "vet today"
            }
          ]
        }
      ]

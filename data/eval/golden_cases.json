    {
      "id": "vet-handoff-yes-sends-once",
      "description": "Read-back of the simulated SMS, 'yes' sends it once, a repeated 'yes' replays (docs/DESIGN.md §5.1).",
      "steps": [
        {
          "tool": "start_health_check",
          "args": {
            "house": "shed two",
            "signs": [
              "swollen_head",
              "sudden_deaths"
            ]
          },
          "save": {
            "check_id": "check_id"
          }
        },
        {
          "tool": "prepare_vet_handoff",
          "args": {
            "house": "shed two",
            "check_id": "$check_id"
          },
          "save": {
            "proposal_id": "proposal_id"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "needs_confirmation"
            },
            {
              "field": "simulated",
              "op": "eq",
              "value": true
            },
            {
              "field": "message_en",
              "op": "contains",
              "value": "26"
            }
          ]
        },
        {
          "tool": "prepare_vet_handoff",
          "args": {
            "house": "shed two",
            "check_id": "$check_id",
            "proposal_id": "$proposal_id",
            "answer": "yes"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "changed"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "simulated"
            }
          ]
        },
        {
          "tool": "prepare_vet_handoff",
          "args": {
            "house": "shed two",
            "check_id": "$check_id",
            "proposal_id": "$proposal_id",
            "answer": "yes"
          },
          "checks": [
            {
              "field": "replayed",
              "op": "eq",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "vet-handoff-no-sends-nothing",
      "description": "'No' to the read-back: nothing is sent.",
      "steps": [

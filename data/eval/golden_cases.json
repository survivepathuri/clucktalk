    {
      "id": "triage-respiratory-with-mortality-spike",
      "description": "House 2 (record-book spike of 26 deaths) + coughing: async check -> urgent, a breathing problem, vet today; no treatment advice.",
      "steps": [
        {
          "tool": "start_health_check",
          "args": {
            "house": "shed two",
            "signs": [
              "coughing",
              "sneezing"
            ]
          },
          "save": {
            "check_id": "check_id"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "analyzing"
            },
            {
              "field": "floor_urgency",
              "op": "eq",
              "value": "urgent"
            }
          ]
        },
        {
          "tool": "get_health_check",
          "args": {
            "check_id": "$check_id"
          },
          "poll_until": {
            "field": "status",
            "op": "ne",
            "value": "analyzing"
          },
          "checks": [
            {
              "field": "status",
              "op": "eq",
              "value": "ready"
            },
            {
              "field": "urgency",
              "op": "eq",
              "value": "urgent"
            },
            {
              "field": "consistent_with.0.category",
              "op": "eq",
              "value": "respiratory"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "26 birds died"
            },
            {
              "field": "text_en",
              "op": "contains",
              "value": "not a diagnosis"
            },
            {
              "field": "text_en",
              "op": "not_contains",
              "value": " ml"
            },
            {
              "field": "text_en",
              "op": "not_contains",
              "value": "antibiotic"
            }
          ]
        }
      ]
    },

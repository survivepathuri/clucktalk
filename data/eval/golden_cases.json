{
  "note": "Minimal golden suite v0 (2026-09-29), mock mode, no AWS. Extended to the full 45-case suite on the 11 Oct task (WEEK2_PLAN). Independent-mode plan_sale cases only: contract-mode is a stateful multi-call flow (switch mode, save terms), covered by tests/contract/test_sale_tools.py instead of this single-call runner.",
  "cases": [
    {
      "id": "farm-status-invocation-example",
      "description": "Doc PRD invocation example: shed two's mortality/feed alert.",
      "tool": "get_farm_status",
      "args": {"house": "shed two"},
      "checks": [
        {"field": "level", "op": "eq", "value": "alert"},
        {"field": "text_en", "op": "contains", "value": "26 birds died today"}
      ]
    },
    {
      "id": "feed-plan-reorder",
      "description": "Shed two's low feed stock triggers a reorder suggestion.",
      "tool": "plan_feed",
      "args": {"house": "shed two"},
      "checks": [
        {"field": "plans.0.reorder_needed", "op": "eq", "value": true},
        {"field": "plans.0.stock_kg", "op": "eq", "value": 900}
      ]
    },
    {
      "id": "sale-rising-mortality-sell-now",
      "description": "House 3: 3 days of rising mortality -> plan_sale says sell today (docs/DESIGN.md §12.4).",
      "tool": "plan_sale",
      "args": {"house": "shed 3"},
      "checks": [
        {"field": "plans.0.mortality_rising", "op": "eq", "value": true},
        {"field": "plans.0.best_day_index", "op": "eq", "value": 0},
        {"field": "plans.0.break_even_day_index", "op": "eq", "value": 1},
        {"field": "text_en", "op": "contains", "value": "selling today is best"}
      ]
    },
    {
      "id": "sale-before-break-even",
      "description": "House 1 at a lower rate (₹80/kg): day 3 is still before the break-even day (8).",
      "tool": "plan_sale",
      "args": {"house": "house one", "live_price_per_kg": 80},
      "checks": [
        {"field": "plans.0.break_even_day_index", "op": "eq", "value": 8},
        {"field": "plans.0.days.3.marginal_profit_inr", "op": "gt", "value": 0}
      ]
    },
    {
      "id": "sale-at-break-even",
      "description": "House 1 at ₹80/kg: marginal profit is still positive the day before break-even, negative on it.",
      "tool": "plan_sale",
      "args": {"house": "house one", "live_price_per_kg": 80},
      "checks": [
        {"field": "plans.0.days.7.marginal_profit_inr", "op": "ge", "value": 0},
        {"field": "plans.0.days.8.marginal_profit_inr", "op": "lt", "value": 0}
      ]
    },
    {
      "id": "sale-after-break-even",
      "description": "House 1 at ₹80/kg: the last projected day is still past break-even and still losing value.",
      "tool": "plan_sale",
      "args": {"house": "house one", "live_price_per_kg": 80},
      "checks": [
        {"field": "plans.0.days.10.marginal_profit_inr", "op": "lt", "value": 0}
      ]
    },
    {
      "id": "help-lists-sale",
      "description": "get_help mentions selling, so a new farmer can discover the feature.",
      "tool": "get_help",
      "args": {},
      "checks": [
        {"field": "text_en", "op": "contains", "value": "sell"}
      ]
    }
  ]
}

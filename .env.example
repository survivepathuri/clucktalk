# CluckTalk environment template. Copy to .env (git-ignored) and fill in:
#   copy .env.example .env
# Never put real values in this file.

# Mock mode: seeded demo data, no AWS calls. The UI shows a visible "Demo data" badge (Rule 6).
MOCK_BEDROCK=true

# Local MCP server: bound to localhost only (docs/DESIGN.md §4)
CLUCKTALK_HOST=127.0.0.1
CLUCKTALK_PORT=8765
# Extra browser origins to allow (and to send CORS headers to), comma-separated exact origins, never "*".
# Empty = only the server's own loopback origins. Used for a browser-based MCP Apps host test only.
CLUCKTALK_ALLOWED_ORIGINS=
# Required in cloud mode; leave empty locally
CLUCKTALK_AUTH_TOKEN=
# Local farm state (profile, pending "yes" requests, records). Empty = .local/clucktalk.sqlite3 (git-ignored).
# `python tasks.py reset-demo` deletes it so the demo story starts fresh.
CLUCKTALK_STATE_PATH=

# Live mode only (MOCK_BEDROCK=false). Region and model IDs are verified on Day 1 and recorded in docs/VERSIONS.md.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=
# Live AI (demo farm + Amazon Nova) needs MOCK_BEDROCK=false set explicitly, plus BEDROCK_MODEL_ID and AWS_REGION,
# e.g. BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0 and AWS_REGION=us-east-1. Daily cap on live model calls:
# at most 100 (hard cap); set a lower number here to spend less.
CLUCKTALK_AI_MAX_CALLS_PER_DAY=

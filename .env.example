# CluckTalk environment template. Copy to .env (git-ignored) and fill in:
#   copy .env.example .env
# Never put real values in this file.

# Mock mode: seeded demo data, no AWS calls. The UI shows a visible "Demo data" badge (Rule 6).
MOCK_BEDROCK=true

# Local MCP server: bound to localhost only (PRD 7.4)
CLUCKTALK_HOST=127.0.0.1
CLUCKTALK_PORT=8765
# Comma-separated Origin allow-list for Streamable HTTP
CLUCKTALK_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Required in cloud mode; leave empty locally
CLUCKTALK_AUTH_TOKEN=

# Live mode only (MOCK_BEDROCK=false). Region and model IDs are verified on Day 1 and recorded in docs/VERSIONS.md.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=

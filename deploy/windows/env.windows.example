# Private environment file for the Windows pilot. PLACEHOLDERS ONLY: never put a real token here or commit one.
# The real file lives OUTSIDE the repository at  C:\clucktalk-pilot\env\pilot.env  (see docs/PILOT_RUNBOOK_WINDOWS.md).
# One KEY=VALUE per line, no quotes, no spaces around the equals sign. Lines that start with # are comments.
# new-token.ps1 replaces the two token placeholders with random values; start-pilot.ps1 refuses to start while any
# <PLACEHOLDER> is left or while a token is weak.

CLUCKTALK_MODE=pilot
MOCK_BEDROCK=true
CLUCKTALK_INSTANCE_NAME=pilot

# The two local ports. Both listen on 127.0.0.1 only. The tunnel forwards ONLY the Simulator port (the page), never the MCP port.
CLUCKTALK_PORT=8765
CLUCKTALK_SIMULATOR_PORT=8766

# The public https address of the free Tailscale Funnel, exactly as the farmer sees it (https, lowercase, no path).
CLUCKTALK_PUBLIC_ORIGIN=https://<FUNNEL_HOST>

# The farmer's token (one per farmer, comma separated) and the Simulator's own token to the MCP server (a different value).
CLUCKTALK_SIMULATOR_TOKENS=<TOKEN_FOR_THE_FARMER>
CLUCKTALK_AUTH_TOKEN=<TOKEN_SIMULATOR_TO_MCP>

# Data files: absolute paths OUTSIDE the repository. The state file name must contain the instance name (pilot).
CLUCKTALK_STATE_PATH=C:\clucktalk-pilot\state\pilot_state.sqlite3
CLUCKTALK_PILOT_FARM_PATH=C:\clucktalk-pilot\pilot_farm.json
CLUCKTALK_DAILY_DEATHS_RULE_PATH=C:\clucktalk-pilot\daily_deaths_rule.json

# Anonymous usage counters (numbers only) and the kill switch: creating this file pauses the pilot, deleting it resumes.
CLUCKTALK_USAGE_PATH=C:\clucktalk-pilot\state\usage_pilot.json
CLUCKTALK_DISABLED_FILE=C:\clucktalk-pilot\state\DISABLED

# Limits (the defaults are 60 and 20).
CLUCKTALK_RATE_PER_MINUTE=60
CLUCKTALK_MAX_SESSIONS=5

# The live weather forecast stays OFF unless both of these are set (it has never been run against the real service):
# CLUCKTALK_WEATHER_RULES_PATH=C:\clucktalk-pilot\weather_rules.json
# CLUCKTALK_WEATHER_LIVE=true

# Environment files for the two instances. PLACEHOLDERS ONLY: never put a real token here or commit one.
# Copy the first block to /etc/clucktalk/pilot.env and the second to /etc/clucktalk/demo.env (mode 640), then replace
# every <...>. Make a token with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ===== /etc/clucktalk/pilot.env  (the farmer's own farm) =====
CLUCKTALK_MODE=pilot
MOCK_BEDROCK=true
CLUCKTALK_INSTANCE_NAME=pilot
CLUCKTALK_PORT=8765
CLUCKTALK_SIMULATOR_PORT=8766
CLUCKTALK_PUBLIC_ORIGIN=https://<PILOT_HOST>
# One bearer token per farmer, comma separated. The farmer opens https://<PILOT_HOST>/#t=<his token> once.
CLUCKTALK_SIMULATOR_TOKENS=<TOKEN_FOR_THE_FARMER>
# The Simulator's own token to the MCP server on this machine (a different value).
CLUCKTALK_AUTH_TOKEN=<TOKEN_SIMULATOR_TO_MCP>
CLUCKTALK_STATE_PATH=/var/lib/clucktalk-pilot/state/pilot_state.sqlite3
CLUCKTALK_PILOT_FARM_PATH=/var/lib/clucktalk-pilot/pilot_farm.json
CLUCKTALK_DAILY_DEATHS_RULE_PATH=/var/lib/clucktalk-pilot/daily_deaths_rule.json
# The live weather forecast stays OFF unless both of these are set (and it has never been run against the real service):
# CLUCKTALK_WEATHER_RULES_PATH=/var/lib/clucktalk-pilot/weather_rules.json
# CLUCKTALK_WEATHER_LIVE=true
CLUCKTALK_RATE_PER_MINUTE=60
CLUCKTALK_MAX_SESSIONS=5
# Kill switch: create this file to pause the pilot at once, delete it to resume (the default is DISABLED next to the state file).
# CLUCKTALK_DISABLED_FILE=/var/lib/clucktalk-pilot/state/DISABLED

# ===== /etc/clucktalk/demo.env  (synthetic data, for judges) =====
# MOCK_BEDROCK=true
# CLUCKTALK_MODE=demo
# CLUCKTALK_INSTANCE_NAME=demo
# CLUCKTALK_PORT=8775
# CLUCKTALK_SIMULATOR_PORT=8776
# CLUCKTALK_PUBLIC_ORIGIN=https://<DEMO_HOST>
# CLUCKTALK_STATE_PATH=/var/lib/clucktalk-demo/state/demo_state.sqlite3
# CLUCKTALK_SIMULATOR_TOKENS=<OPTIONAL_TOKEN_FOR_JUDGES>
